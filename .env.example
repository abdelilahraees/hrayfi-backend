# ============================================================
# Copier ce fichier vers `.env` et remplir les vraies valeurs.
# `.env` est gitignoré — ne jamais le committer.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=hrayfi
POSTGRES_USER=hrayfi
POSTGRES_PASSWORD=change_me_in_local

# --- DataSource Spring (laisser tel quel pour docker-compose local) ---
DB_URL=jdbc:postgresql://localhost:5432/hrayfi
DB_USERNAME=hrayfi
DB_PASSWORD=change_me_in_local

# --- JWT ---
# Secret base64 >= 32 octets. Pour en générer un :
#   openssl rand -base64 48
JWT_SECRET=remplace_moi_par_un_secret_base64_de_minimum_32_octets_svp
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- pgAdmin (console web http://localhost:5050) ---
PGADMIN_EMAIL=admin@hrayfi.local
PGADMIN_PASSWORD=admin